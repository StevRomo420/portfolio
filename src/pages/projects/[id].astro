---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${project.data.title} — Esteban Rosales`} description={project.data.summary}>
  <main class="project-page">
    <a class="project-back" href={`${base}#labs`}><span>← LABS</span><strong class="identity-name">ESTEBAN ROSALES</strong></a>
    <article class="project-detail" data-reveal>
      <div class="project-detail__head">
        <div>
          <div class="eyebrow">{project.data.code} / {project.data.status}</div>
          <h1>{project.data.title}</h1>
          <p class="project-detail__subtitle">{project.data.subtitle}</p>
        </div>
        <div class="status-dot"><i></i>{project.data.status}</div>
      </div>
      <p class="project-detail__summary">{project.data.summary}</p>
      <div class="tag-row">{project.data.stack.map((item) => <span>{item}</span>)}</div>
      {project.data.architectureImage && (
        <figure class="project-architecture">
          <picture>
            {project.data.architectureMobileImage && <source media="(max-width: 620px)" srcset={`${base}${project.data.architectureMobileImage.replace(/^\//, '')}`} />}
            <img src={`${base}${project.data.architectureImage.replace(/^\//, '')}`} alt={`Sanitized production architecture for ${project.data.title}`} loading="eager" />
          </picture>
          {project.data.architectureCaption && <figcaption>{project.data.architectureCaption}</figcaption>}
        </figure>
      )}
      {project.data.secondaryArchitectureImage && (
        <figure class="project-architecture project-architecture--secondary">
          <picture>
            {project.data.secondaryArchitectureMobileImage && <source media="(max-width: 620px)" srcset={`${base}${project.data.secondaryArchitectureMobileImage.replace(/^\//, '')}`} />}
            <img src={`${base}${project.data.secondaryArchitectureImage.replace(/^\//, '')}`} alt={`Technical workflow for ${project.data.title}`} loading="lazy" />
          </picture>
          {project.data.secondaryArchitectureCaption && <figcaption>{project.data.secondaryArchitectureCaption}</figcaption>}
        </figure>
      )}
      <div class="project-prose"><Content /></div>
      <div class="redaction-note">
        <span>DISCLOSURE POLICY</span>
        Production identifiers, exact network topology, credentials and sensitive detection logic are intentionally omitted.
      </div>
    </article>
  </main>
</BaseLayout>
